    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst isError = item.error !== undefined || item.statusCode >= 400;\n\nreturn {\n  json: {\n    status: isError ? \"FAILED\" : \"SENT\",\n    email: item.to || $('Loop_Over_Items').item.json.email,\n    processedAt: new Date().toISOString()\n  }\n};"
      },
