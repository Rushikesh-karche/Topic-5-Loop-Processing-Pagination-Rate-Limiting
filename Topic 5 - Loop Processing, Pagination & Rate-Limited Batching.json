        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst totalUsers = (staticData.accumulatedUsers || []).length;\n\nreturn [{\n  json: {\n    pipelineSummary: \"BATCH_PAGINATION_COMPLETE\",\n    totalPagesHarvested: (staticData.currentPage || 2) - 1,\n    totalUsersProcessed: totalUsers,\n    completedAt: new Date().toISOString()\n  }\n}];"
      },
