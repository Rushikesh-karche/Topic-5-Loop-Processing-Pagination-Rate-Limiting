      "parameters": {
        "jsCode": "// Global memory state for active pagination execution\nconst staticData = $getWorkflowStaticData('global');\nstaticData.accumulatedUsers = [];\nstaticData.currentPage = 1;\n\nreturn [{\n  json: {\n    currentPage: 1,\n    pageSize: $('Set_Config').first().json.pageSize || 10,\n    status: \"START_FETCH\"\n  }\n}];"
      },
      "id": "ce3a696a-3642-4f36-b633-89981be1e43b",
      "name": "Code_InitPaging",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://jsonplaceholder.typicode.com/users",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "_page",
              "value": "={{ $('Code_AccumulatePage').isExecuted ? $('Code_AccumulatePage').last().json.currentPage : 1 }}"
            },
            {
              "name": "_limit",
              "value": "={{ $('Set_Config').first().json.pageSize || 10 }}"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
