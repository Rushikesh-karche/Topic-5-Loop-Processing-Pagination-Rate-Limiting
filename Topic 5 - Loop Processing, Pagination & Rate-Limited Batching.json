        -120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst inputData = $input.first().json;\nconst newItems = Array.isArray(inputData.items) ? inputData.items : $input.all().map(i => i.json);\n\n// Safely accumulate items even during manual node testing\nstaticData.accumulatedUsers = (staticData.accumulatedUsers || []).concat(newItems);\nstaticData.currentPage = (staticData.currentPage || 1) + 1;\n\nconst maxPages = $('Set_Config').first().json.maxPages || 10;\nconst hasHitMax = staticData.currentPage > maxPages;\n\nreturn [{\n  json: {\n    currentPage: staticData.currentPage,\n    totalAccumulatedSoFar: staticData.accumulatedUsers.length,\n    shouldContinue: !hasHitMax && newItems.length > 0\n  }\n}];"
      },
      "id": "1eb45c2f-e8b9-4f76-96a1-9a742880cf2e",
      "name": "Code_AccumulatePage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst users = staticData.accumulatedUsers || [];\n\n// Unroll array into separate n8n items\nreturn users.map(user => ({ json: user }));"
      },
